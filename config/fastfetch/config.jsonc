{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "debian",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 15 },
    "color": { "keys": "red", "separator": "bright_black" }
  },
  "modules": [
    "break",
    "title",
    "separator",
    { "type": "os",       "key": "  Distro" },
    { "type": "kernel",   "key": "  Kernel" },
    { "type": "uptime",   "key": "  Encendido" },
    { "type": "packages", "key": "  Paquetes" },
    "break",
    { "type": "wm",       "key": "  Compositor" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "shell",    "key": "  Shell" },
    { "type": "display",  "key": "  Pantalla", "format": "{width}x{height} @ {refresh-rate} Hz" },
    "break",
    { "type": "cpu",      "key": "  CPU", "format": "{1}" },
    { "type": "gpu",      "key": "  GPU", "format": "{2}" },
    { "type": "memory",   "key": "  RAM" },
    { "type": "disk",     "key": "  Disco", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "  Batería" }
  ]
}
